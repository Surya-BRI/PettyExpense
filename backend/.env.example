APP_NAME=Expense Receipt App
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ERP Dev SQL Server — required
READER_DB_SERVER=
READER_DB_NAME=
