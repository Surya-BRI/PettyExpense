APP_NAME=Expense Receipt App
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ERP Dev SQL Server — required
READER_DB_SERVER=
READER_DB_NAME=
READER_DB_USER=
READER_DB_PASSWORD=
READER_DB_DRIVER=ODBC Driver 17 for SQL Server

# AWS S3 (receipt images + signed URLs)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=
AWS_FOLDER=live

OCR_BACKEND=paddle
# Unused for live scans (GPT is the only pipeline). Kept for compare scripts.
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Required: every camera / gallery scan is sent to this provider
AI_VISION_PROVIDER=openai
# runpod provider: self-hosted Qwen3-VL on the official RunPod vLLM worker (uses RUNPOD_API_KEY)
RUNPOD_VISION_ENDPOINT_ID=
# Key scoped to the vision endpoint (restricted keys are per-endpoint); blank = RUNPOD_API_KEY
RUNPOD_VISION_API_KEY=
RUNPOD_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
CORS_ORIGINS=*

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
NOTIFY_EMAIL_ENABLED=false
